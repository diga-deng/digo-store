# Test payments only until the end-to-end checks in PAYMENT_SETUP.md pass.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://digo-store-diagnostic.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SECRET=

# Language models (optional, server only). One group per model, up to five, tried in order.
# Any provider with an OpenAI-compatible chat completions address works; DeepSeek is shown.
DIGO_MODEL_1_NAME=DeepSeek
DIGO_MODEL_1_URL=https://api.deepseek.com/chat/completions
DIGO_MODEL_1_MODEL=deepseek-flash
DIGO_MODEL_1_KEY=
# Optional JSON merged into each request, for one provider's own switches.
DIGO_MODEL_1_EXTRA=
